# Copiá este archivo como .env y completá los valores.
# El .env real nunca se sube al repositorio (está en .gitignore).

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bases SQLite. Las dos son opcionales: sin ellas se usan las rutas por defecto.
#   SQLITE_RUTA     -> base pública de reclamos, de solo lectura
#                      (por defecto backend/datos_basePublica/reclamos.db)
#   HISTORIAL_RUTA  -> historial de preguntas y costos del agente, se crea solo
#                      (por defecto backend/datos_app/historial.db)
SQLITE_RUTA=
HISTORIAL_RUTA=

# Seguimiento de lo que hace el agente. Ver backend/trazas.py.
#   local      -> backend/trazas/AAAA-MM-DD.jsonl, no sale nada de la maquina
#   langsmith  -> sube prompts y resultados a la nube de LangSmith
#   ninguna    -> no registra nada
# Ojo con langsmith: los prompts incluyen el diccionario completo de la tabla.
TRAZAS=local
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-analitica

# Azure OpenAI (opcional). Con estas dos puestas el agente usa Azure en vez
# de OpenAI directo; sin ellas, usa OPENAI_API_KEY. El endpoint tiene que
# terminar en /openai/v1, que es la superficie compatible con la API de OpenAI.
# El deployment debe llamarse igual que el modelo (MODELO en main.py) para
# que la tabla de precios de uso_tokens.py lo encuentre.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
